<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} [%t] %-5level %logger{1} - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>

        <!-- Suppress noisy loggers -->
        <Logger name="org.openqa.selenium" level="warn"/>
        <Logger name="org.openqa.selenium.devtools" level="error"/>
        <Logger name="org.openqa.selenium.chromium" level="error"/>
        <Logger name="io.github.bonigarcia.wdm" level="warn"/>
        <Logger name="org.testng" level="warn"/>
        <Logger name="org.testng.internal.Utils" level="error"/>
    </Loggers>
</Configuration>